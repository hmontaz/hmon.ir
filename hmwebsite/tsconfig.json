{
	"compilerOptions": {
		//"target": "es2020",
		"module": "es2020",
		"moduleResolution": "node",
		"outDir": "./dist",
		"sourceMap": true,
		"target": "es6",
		"strict": true,
		"esModuleInterop": true,
		"allowJs": true,
		"noEmitOnError": true,
		"removeComments": false,
		"lib": [ "dom", "es2020", "dom.iterable" ],
		"types": [ "jest" ]
	},
	"include": [ "src", "tests" ],
	"exclude": [ "node_modules", "wwwroot" ],
	"compileOnSave": true
}
